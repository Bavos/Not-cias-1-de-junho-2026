      "id": "af2ce53c-3d7c-4ff3-bca3-b438d47b9d30",
      "name": "Validate fileUrl",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const input = $input.first().json;\n\nconst rawFileUrl = String(input.fileUrl || '').trim();\nconst rawFileName = String(input.fileName || 'brasil-mundo-agora-35s.mp4').trim();\nconst rawVideoTitle = String(input.videoTitle || 'Brasil e Mundo Agora').trim();\n\nconst fallbackName = 'brasil-mundo-agora-35s.mp4';\nconst withoutPath = rawFileName.split(/[\\\\/]/).filter(Boolean).pop() || fallbackName;\nconst safeFileName = withoutPath\n  .replace(/[^a-zA-Z0-9._-]/g, '-')\n  .replace(/-+/g, '-')\n  .replace(/^\\.+/, '')\n  .slice(0, 160) || fallbackName;\n\nreturn [\n  {\n    json: {\n      fileUrl: rawFileUrl,\n      fileName: safeFileName,\n      videoTitle: rawVideoTitle,\n      createdAt: input.createdAt,\n      filePath: `downloads/generated/${safeFileName}`,\n      tempPath: 'downloads/temp',\n    },\n  },\n];"
      },
      "id": "fe5c5c76-2938-4e7a-8681-6d84b48b3ac0",
      "name": "Prepare Download",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        740,
        -120
      ]
    },
    {
      "parameters": {
        "command": "mkdir -p downloads/generated downloads/temp"
      },
      "id": "9b2ff70a-9c24-4d33-b759-eedfe85905ac",
      "name": "Ensure Download Folders",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        980,
        -120
      ]
    },
    {
      "parameters": {
        "url": "={{$('Prepare Download').item.json.fileUrl}}",
        "options": {
          "response": {
            "response": {
